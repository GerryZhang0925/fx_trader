//@version=5
strategy("EURUSD M5 Kill Zone Score", overlay=true,
     initial_capital=100000, pyramiding=0, process_orders_on_close=false,
     commission_type=strategy.commission.cash_per_order, commission_value=0,
     default_qty_type=strategy.fixed, default_qty_value=1,
     calc_on_every_tick=false, max_bars_back=5000)

// Original simplified model. Not a copy of any published ICT script.

londonSess = input.session("0700-1000", "London (UTC)")
nySess = input.session("1300-1600", "New York (UTC)")
sessTz = input.string("UTC", "Session timezone")
h1Fast = input.int(21, "H1 fast EMA")
h1Slow = input.int(50, "H1 slow EMA")
h1Trend = input.int(200, "H1 trend EMA")
m5Fast = input.int(9, "M5 fast EMA")
m5Slow = input.int(21, "M5 slow EMA")
swingLen = input.int(5, "Swing length")
minScore = input.int(6, "Min confluence score")
tpR = input.float(2.0, "Take profit R")
atrLen = input.int(14, "ATR length")
atrMult = input.float(1.5, "Min stop ATR multiple")
usePdhPdl = input.bool(true, "Target previous day high/low")
riskPct = input.float(1.0, "Risk % of equity", minval=0.1, step=0.1)
maxTradesDay = input.int(2, "Max trades per day")
maxConsecLoss = input.int(3, "Consecutive losses halt")
maxDailyR = input.float(2.0, "Daily loss R halt")

h1EmaF = request.security(syminfo.tickerid, "60", ta.ema(close, h1Fast), lookahead=barmerge.lookahead_off)
h1EmaS = request.security(syminfo.tickerid, "60", ta.ema(close, h1Slow), lookahead=barmerge.lookahead_off)
h1EmaT = request.security(syminfo.tickerid, "60", ta.ema(close, h1Trend), lookahead=barmerge.lookahead_off)
bullStack = h1EmaF > h1EmaS and h1EmaS > h1EmaT
bearStack = h1EmaF < h1EmaS and h1EmaS < h1EmaT

inLondon = not na(time(timeframe.period, londonSess, sessTz))
inNY = not na(time(timeframe.period, nySess, sessTz))
inKz = inLondon or inNY

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)
var float swingHigh = na
var float swingLow = na
if not na(ph)
    swingHigh := ph
if not na(pl)
    swingLow := pl

sweepBull = not na(swingLow) and low < swingLow and close > swingLow
sweepBear = not na(swingHigh) and high > swingHigh and close < swingHigh
fvgBull = low > high[2]
fvgBear = high < low[2]
m5Bull = ta.ema(close, m5Fast) > ta.ema(close, m5Slow)
m5Bear = ta.ema(close, m5Fast) < ta.ema(close, m5Slow)

scoreLong = (inKz ? 2 : 0) + (bullStack ? 2 : 0) + (sweepBull ? 3 : 0) + (fvgBull ? 2 : 0) + (m5Bull ? 1 : 0)
scoreShort = (inKz ? 2 : 0) + (bearStack ? 2 : 0) + (sweepBear ? 3 : 0) + (fvgBear ? 2 : 0) + (m5Bear ? 1 : 0)

longCond = inKz and bullStack and sweepBull and scoreLong >= minScore
shortCond = inKz and bearStack and sweepBear and scoreShort >= minScore

atrVal = ta.atr(atrLen)
stopLong = low - atrVal * 0.1
stopShort = high + atrVal * 0.1
distLong = math.max(close - stopLong, atrVal * atrMult)
distShort = math.max(stopShort - close, atrVal * atrMult)

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_off)
tpLong = usePdhPdl and not na(pdh) ? pdh : close + distLong * tpR
tpShort = usePdhPdl and not na(pdl) ? pdl : close - distShort * tpR

var int tradesToday = 0
var int consecLoss = 0
var float dailyR = 0.0
var float lastRiskAmt = na
var int closedSeen = 0

if timeframe.change("D")
    tradesToday := 0
    dailyR := 0.0

if strategy.closedtrades > closedSeen
    for i = closedSeen to strategy.closedtrades - 1
        p = strategy.closedtrades.profit(i)
        rMult = nz(lastRiskAmt) > 0 ? p / lastRiskAmt : 0.0
        dailyR += rMult
        consecLoss := p < 0 ? consecLoss + 1 : 0
    closedSeen := strategy.closedtrades

halted = consecLoss >= maxConsecLoss or dailyR <= -maxDailyR
canTrade = tradesToday < maxTradesDay and not halted and inKz

bgcolor(inLondon ? color.new(color.blue, 85) : inNY ? color.new(color.red, 85) : na)

if canTrade and strategy.position_size == 0
    if longCond
        riskAmt = strategy.equity * riskPct / 100.0
        qty = distLong > 0 ? riskAmt / distLong : na
        strategy.entry("Long", strategy.long, qty=qty)
        strategy.exit("XL", from_entry="Long", stop=stopLong, limit=tpLong)
        lastRiskAmt := riskAmt
        tradesToday += 1
    else if shortCond
        riskAmt = strategy.equity * riskPct / 100.0
        qty = distShort > 0 ? riskAmt / distShort : na
        strategy.entry("Short", strategy.short, qty=qty)
        strategy.exit("XS", from_entry="Short", stop=stopShort, limit=tpShort)
        lastRiskAmt := riskAmt
        tradesToday += 1

plot(ta.ema(close, m5Fast), "M5 EMA9", color=color.aqua)
plot(ta.ema(close, m5Slow), "M5 EMA21", color=color.orange)
plotshape(longCond and canTrade, "Long", shape.triangleup, location.belowbar, color.teal, size=size.tiny)
plotshape(shortCond and canTrade, "Short", shape.triangledown, location.abovebar, color.red, size=size.tiny)

var table dash = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 70))
if barstate.islast
    table.cell(dash, 0, 0, "KZ", text_color=color.white)
    table.cell(dash, 1, 0, inKz ? "IN" : "OUT", text_color=inKz ? color.lime : color.gray)
    table.cell(dash, 0, 1, "H1", text_color=color.white)
    table.cell(dash, 1, 1, bullStack ? "LONG" : bearStack ? "SHORT" : "FLAT", text_color=color.white)
    table.cell(dash, 0, 2, "L score", text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(scoreLong), text_color=color.white)
    table.cell(dash, 0, 3, "S score", text_color=color.white)
    table.cell(dash, 1, 3, str.tostring(scoreShort), text_color=color.white)

alertcondition(longCond, "KZ long", "EURUSD kill-zone long")
alertcondition(shortCond, "KZ short", "EURUSD kill-zone short")
