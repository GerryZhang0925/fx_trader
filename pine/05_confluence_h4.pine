//@version=5
strategy("EURUSD H4 Confluence Donchian+Engulfing", overlay=true,
     initial_capital=100000, pyramiding=0, process_orders_on_close=false,
     commission_type=strategy.commission.cash_per_order, commission_value=0,
     default_qty_type=strategy.fixed, default_qty_value=1,
     calc_on_every_tick=false, max_bars_back=5000)

// Same-direction H4 wrapper. Apply 03_killzone_m5.pine on M5 for timing.

donchLen = input.int(55, "Donchian length")
emaLen = input.int(200, "Trend EMA")
atrLen = input.int(14, "ATR length")
atrMult = input.float(2.5, "Donchian ATR multiple")
adxLen = input.int(14, "ADX length")
adxRangeMax = input.float(20.0, "Range ADX max")
widthPct = input.float(1.2, "Donchian width % for range", step=0.1)
rvolLen = input.int(20, "Rvol length")
rvolMin = input.float(1.2, "Min Rvol")
swingLen = input.int(5, "Swing length")
minRoomR = input.float(1.5, "Engulf min room R")
engulfTpR = input.float(2.0, "Engulf TP R")
riskPct = input.float(1.0, "Risk % of equity", minval=0.1, step=0.1)
maxTradesDay = input.int(2, "Max trades per day")
maxConsecLoss = input.int(3, "Consecutive losses halt")
maxDailyR = input.float(2.0, "Daily loss R halt")

emaTrend = ta.ema(close, emaLen)
donchHi = ta.highest(high, donchLen)[1]
donchLo = ta.lowest(low, donchLen)[1]
atrVal = ta.atr(atrLen)
adxVal = ta.adx(adxLen)
width = (donchHi - donchLo) / close
ranging = adxVal <= adxRangeMax or width <= widthPct / 100.0
bias = close > emaTrend ? 1 : close < emaTrend ? -1 : 0

coreLong = close > donchHi and close > emaTrend
coreShort = close < donchLo and close < emaTrend

rvol = volume / ta.sma(volume, rvolLen)
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bullEng = close > open and close[1] < open[1] and bodyBot <= math.min(open[1], close[1]) and bodyTop >= math.max(open[1], close[1])
bearEng = close < open and close[1] > open[1] and bodyTop >= math.max(open[1], close[1]) and bodyBot <= math.min(open[1], close[1])
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)
var float swingHigh = na
var float swingLow = na
if not na(ph)
    swingHigh := ph
if not na(pl)
    swingLow := pl
stopLongE = math.min(low, low[1]) - atrVal * 0.1
stopShortE = math.max(high, high[1]) + atrVal * 0.1
distLongE = math.max(close - stopLongE, atrVal * 0.5)
distShortE = math.max(stopShortE - close, atrVal * 0.5)
roomL = not na(swingHigh) ? (swingHigh - close) / distLongE : 0.0
roomS = not na(swingLow) ? (close - swingLow) / distShortE : 0.0
subLong = ranging and bullEng and rvol >= rvolMin and roomL >= minRoomR and bias == 1
subShort = ranging and bearEng and rvol >= rvolMin and roomS >= minRoomR and bias == -1

useCore = coreLong or coreShort
longCond = coreLong or (not useCore and subLong)
shortCond = coreShort or (not useCore and subShort)
isCore = coreLong or coreShort

stopDist = isCore ? atrVal * atrMult : (longCond ? distLongE : distShortE)
limitPx = isCore ? na : (longCond ? close + distLongE * engulfTpR : close - distShortE * engulfTpR)

var int tradesToday = 0
var int consecLoss = 0
var float dailyR = 0.0
var float lastRiskAmt = na
var int closedSeen = 0
var float trailLong = na
var float trailShort = na

if timeframe.change("D")
    tradesToday := 0
    dailyR := 0.0

if strategy.closedtrades > closedSeen
    for i = closedSeen to strategy.closedtrades - 1
        p = strategy.closedtrades.profit(i)
        rMult = nz(lastRiskAmt) > 0 ? p / lastRiskAmt : 0.0
        dailyR += rMult
        consecLoss := p < 0 ? consecLoss + 1 : 0
    closedSeen := strategy.closedtrades

halted = consecLoss >= maxConsecLoss or dailyR <= -maxDailyR
canTrade = tradesToday < maxTradesDay and not halted and stopDist > 0
riskAmt = strategy.equity * riskPct / 100.0
qty = stopDist > 0 ? riskAmt / stopDist : na

if canTrade and strategy.position_size == 0
    if longCond
        strategy.entry("Long", strategy.long, qty=qty)
        lastRiskAmt := riskAmt
        tradesToday += 1
    else if shortCond
        strategy.entry("Short", strategy.short, qty=qty)
        lastRiskAmt := riskAmt
        tradesToday += 1

if strategy.position_size > 0
    if strategy.position_size[1] <= 0
        trailLong := strategy.position_avg_price - stopDist
    else if isCore[1]
        trailLong := math.max(nz(trailLong), high - atrVal * atrMult)
    strategy.exit("XL", from_entry="Long", stop=trailLong, limit=strategy.position_size[1] > 0 and not isCore[1] ? limitPx : na)

if strategy.position_size < 0
    if strategy.position_size[1] >= 0
        trailShort := strategy.position_avg_price + stopDist
    else if isCore[1]
        trailShort := math.min(nz(trailShort, 1e10), low + atrVal * atrMult)
    strategy.exit("XS", from_entry="Short", stop=trailShort)

plot(emaTrend, "EMA 200", color=color.orange)
plot(donchHi, "Donchian high", color=color.teal)
plot(donchLo, "Donchian low", color=color.red)
plotshape(longCond and canTrade, "Long", shape.triangleup, location.belowbar, color.lime, size=size.tiny)
plotshape(shortCond and canTrade, "Short", shape.triangledown, location.abovebar, color.red, size=size.tiny)
