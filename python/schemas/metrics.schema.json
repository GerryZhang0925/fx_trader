{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eurusd-signals.local/schemas/metrics.schema.json",
  "title": "BacktestMetrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trades",
    "win_rate",
    "profit_factor",
    "return_pct",
    "cagr",
    "max_drawdown_pct",
    "sharpe",
    "sortino",
    "calmar",
    "years"
  ],
  "properties": {
    "trades": { "type": "integer", "minimum": 0 },
    "wins": { "type": "integer", "minimum": 0 },
    "losses": { "type": "integer", "minimum": 0 },
    "win_rate": { "type": "number" },
    "profit_factor": { "type": "number" },
    "net_pnl": { "type": "number" },
    "return_pct": { "type": "number" },
    "cagr": { "type": "number" },
    "max_drawdown_pct": { "type": "number" },
    "sharpe": { "type": "number", "description": "Daily returns, annualized sqrt(252), Rf=0" },
    "sortino": { "type": "number", "description": "Daily excess vs MAR=0, annualized" },
    "calmar": { "type": "number", "description": "CAGR / |MDD|" },
    "ulcer_index": { "type": "number" },
    "avg_r": { "type": "number" },
    "yearly_return_mean": { "type": "number" },
    "yearly_return_std": { "type": "number" },
    "years": { "type": "number" },
    "start": { "type": "string" },
    "end": { "type": "string" },
    "final_equity": { "type": "number" },
    "kelly_trade": { "type": "number", "description": "Discrete f* from win rate and payoff b" },
    "kelly_growth": { "type": "number", "description": "Continuous f* = μ/σ² on daily returns, Rf=0" },
    "half_kelly_trade": { "type": "number" },
    "half_kelly_growth": { "type": "number" }
  }
}
